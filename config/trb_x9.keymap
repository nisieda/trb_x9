#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp N0    &mkp MB1  &mb3_scroll 3 MB3  &mkp MB2  &kp N4  &kp N5
&kp N2
&lt 2 N3
&lt 1 N4
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp LEFT  &kp SPACE  &kp RIGHT  &rotate_step (-1)  &rotate_step 1 
&trans
&trans
&trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &rotate_step (-1)  &trans  &rotate_step 1   &trans  &trans
&trans
&trans
&trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans
&trans
&trans
&trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans
&trans
&trans
&trans
            >;
        };
    };
};
